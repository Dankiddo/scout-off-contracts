# Rust / Cargo
target/
**/target/
Cargo.lock

# Environment secrets — never commit these
.env
.env.*
!.env.example

# Migration state exports (may contain player PII) — never commit these
migration-export/

# Compiled WASM outputs (raw, optimized, and CI-produced)
*.wasm
*.optimized.wasm
*.wasm.gz

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# AI/agent tool state — local only
.kiro/
.claude/
.kilocode/
.opencode/

# Pull-request drafts
pr-*.md

# Bindings — generated src/ and compiled dist/ are not committed.
# Only package.json and tsconfig.json scaffolds are tracked.
bindings/*/src/
bindings/*/dist/
bindings/*/node_modules/
bindings/*/*.tsbuildinfo

# Contract ABI / WASM-size artifacts regenerated by CI
abi/
abi-smoke/
abi/base/
abi-diff/
wasm-sizes.json

# Local sandbox + deploy state
.stellar/
sandbox/
.env.contracts.local
*.pid

# Test snapshots generated by soroban test runner, Jest, and Vitest
**/test_snapshots/
**/__snapshots__/
**/snapshots/
*.snap
*.snap.new
*.snap.next

# Test / coverage output
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/
.playwright/

# Temporary files
*.tmp
*.bak
*.orig
*.rej
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Compiled TypeScript output (tsc build artifact of src/)
dist/

# Node / npm
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.npm/

# Cache dirs
.cache/
.parcel-cache/
.eslintcache
.ruff_cache/
__pycache__/
*.py[cod]
.pytest_cache/

# Local calibration artifacts
calibration-report.json
budget-drift.json
cpu-cost-budget-report.txt
